{
  "manifest_version": 3,
  "name": "ESPN Cookie Extractor",
  "version": "1.0.0",
  "description": "Extract SWID and espn_s2 cookies for Fantasy Football AI.",
  "permissions": [
    "cookies",
    "clipboardWrite",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.espn.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
